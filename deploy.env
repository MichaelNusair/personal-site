# Deploy target + the public build args baked into the image.
#
# Single source of truth: scripts/deploy.sh sources this file, and CI runs that
# same script, so a value never has to be changed in two places. Everything
# here is public (it ends up in client-side JS); secrets belong in Secrets
# Manager, never in this file.
#
# Every value uses ${VAR:-default}, so anything already exported wins — that is
# how CI drops the local AWS profile (`AWS_PROFILE_NAME= ./scripts/deploy.sh`,
# where credentials come from the environment instead).

# ─── Where it deploys ───────────────────────────────────────────────
# Account 481432042359. These resources are NOT managed by CloudFormation —
# read "Infrastructure" in README.md before renaming one.
AWS_PROFILE_NAME="${AWS_PROFILE_NAME-mntech1}"
AWS_REGION="${AWS_REGION:-us-east-1}"
ECR_REPO="${ECR_REPO:-mntech-internal-web}"
LAMBDA_FUNCTION="${LAMBDA_FUNCTION:-mntech-internal-ssr}"

# Instruction set for the function and the image. `arm64` because the machine
# this deploys from is aarch64, so the build is native: cross-building amd64
# under QEMU took 46 minutes and then died with ECONNRESET in `npm ci`, because
# emulated TLS is slow enough that the registry hangs up. arm64 Lambda is also
# about 20% cheaper. Set to `x86_64` to go back; the script switches the live
# function's architecture either way, and the Lambda Web Adapter tag in the
# Dockerfile is a multi-arch manifest, so it follows along on its own.
TARGET_ARCH="${TARGET_ARCH:-arm64}"

# ─── What gets baked into the build ─────────────────────────────────
NEXT_PUBLIC_SITE_PROFILE="${NEXT_PUBLIC_SITE_PROFILE:-personal}"
NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL:-https://michaelnusair.site}"
NEXT_PUBLIC_CHAT_API_BASE="${NEXT_PUBLIC_CHAT_API_BASE:-https://chatapi.michaelnusair.site/}"

# ─── How the deploy verifies itself ─────────────────────────────────
# Hit after the Lambda update; the deploy fails if this does not serve 200 with
# og:url set to NEXT_PUBLIC_SITE_URL above.
SMOKE_URL="${SMOKE_URL:-https://michaelnusair.site/}"

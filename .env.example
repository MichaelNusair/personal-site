# ── White-label (optional; defaults to personal / michaelnusair.site) ──
# NEXT_PUBLIC_SITE_PROFILE=personal
# NEXT_PUBLIC_SITE_URL=https://michaelnusair.site
# NEXT_PUBLIC_CHAT_API_BASE=https://chatapi.michaelnusair.site/
# Strike Labs build example:
# NEXT_PUBLIC_SITE_PROFILE=strike_labs
# NEXT_PUBLIC_SITE_URL=https://strikelabs.tech
# Optional GetVL funnel URLs (defaults to strike.getvl.shop paths)
# NEXT_PUBLIC_GETVL_START_IDEA_URL=https://strike.getvl.shop/start/idea
# NEXT_PUBLIC_GETVL_UPLOAD_RFQ_URL=https://strike.getvl.shop/start/upload

# NextAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://michaelnusair.site

# Database
DATABASE_URL=postgresql://user:password@host:5432/transcriptions?schema=public

# AWS S3 (for audio file uploads)
UPLOADS_BUCKET=transcriptions-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Chat runs on Claude via Amazon Bedrock and needs no key -- the Lambda's role
# is the credential. Override only to pin a different model; the Messages-API
# endpoint wants the bare `anthropic.` id, not a `us.` inference profile.
BEDROCK_CHAT_MODEL=anthropic.claude-opus-5-5

